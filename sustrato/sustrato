            "ollama":     {"name":"Ollama (local)","base_url":"http://localhost:11434/v1","auth_type":"none","env_vars":[]},
        }
    return providers

HERMES_PROVIDERS = _get_hermes_providers()

# ── Config I/O ────────────────────────────────────────────────────────
def load_config() -> dict:
    if CONFIG_PATH.exists():
        with open(CONFIG_PATH) as f: return yaml.safe_load(f) or {}
    return {"chain": [], "auto_failover": True, "health_check_timeout": 5, "fail_threshold": 3}

def save_config(cfg: dict):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        yaml.safe_dump(cfg, f, default_flow_style=False, sort_keys=False)

def load_state() -> dict:
    if STATE_PATH.exists():
        with open(STATE_PATH) as f: return json.load(f)
    return {"active_index": 0, "failures": {}, "last_switch": None, "last_success": None}

def save_state(state: dict):
    with open(STATE_PATH, "w") as f: json.dump(state, f, indent=2)

# ── Health check (real endpoint probes) ───────────────────────────────
_OLLAMA_ENDPOINTS = ["/api/tags", "/models", "/"]

def check_health(entry: dict, timeout: int = 5) -> bool:
    provider = entry.get("provider", "")
    url = entry.get("url", "")

    # Ollama: try actual API endpoints, not just TCP
    if provider == "ollama" or "localhost" in url or "192.168" in url or "10." in url or "172." in url:
        base = (url or "http://localhost:11434/v1").rstrip("/")
        for ep in _OLLAMA_ENDPOINTS:
            try:
                req = urllib.request.Request(f"{base}{ep}")
                resp = urllib.request.urlopen(req, timeout=timeout)
                if resp.status == 200:
                    return True
            except Exception:
                continue
        return False

    # Cloud providers: TCP connect to API host
    endpoints = {
        "deepseek": ("api.deepseek.com", 443),
        "openrouter": ("openrouter.ai", 443),
        "anthropic": ("api.anthropic.com", 443),
        "openai": ("api.openai.com", 443),
        "openai-codex": ("api.openai.com", 443),
        "google": ("generativelanguage.googleapis.com", 443),
        "xai": ("api.x.ai", 443),
        "groq": ("api.groq.com", 443),
        "nvidia": ("integrate.api.nvidia.com", 443),
    }
    target = endpoints.get(provider)
    if not target:
        return True
    try:
        socket.create_connection(target, timeout=timeout)
        return True
    except Exception:
        return False


def check_health_deep(entry: dict, timeout: int = 8) -> tuple:
    """Deep health check — tests API with credentials. Returns (bool, detail)."""
    provider = entry.get("provider", "")
    model = entry.get("model", "")
    url = entry.get("url", "")

    # Load API keys from .env
    env_path = _hermes_dir() / ".env"
    env_vars = {}
    if env_path.exists():
        for line in env_path.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env_vars[k.strip()] = v.strip().strip('"').strip("'")

    # Provider-specific API key env vars
    key_envs = {
        "deepseek": ["DEEPSEEK_API_KEY"],
        "openai": ["OPENAI_API_KEY"],
        "openai-codex": ["OPENAI_API_KEY"],
        "openrouter": ["OPENROUTER_API_KEY"],
        "anthropic": ["ANTHROPIC_API_KEY", "ANTHROPIC_TOKEN"],
        "google": ["GOOGLE_API_KEY", "GEMINI_API_KEY"],
        "xai": ["XAI_API_KEY"],
        "groq": ["GROQ_API_KEY"],
        "nvidia": ["NVIDIA_API_KEY"],
        "zai": ["GLM_API_KEY", "ZAI_API_KEY"],
        "kimi-coding": ["KIMI_API_KEY"],
        "minimax": ["MINIMAX_API_KEY"],
    }
    keys = key_envs.get(provider, [])
    api_key = ""
    for k in keys:
        if env_vars.get(k):
            api_key = env_vars[k]
            break

    # Ollama / local: already covered by basic check, but try /api/tags
    if provider == "ollama" or "localhost" in url or "192.168" in url or "10." in url:
        base = (url or "http://localhost:11434/v1").rstrip("/")
        try:
            req = urllib.request.Request(f"{base}/api/tags")
            resp = urllib.request.urlopen(req, timeout=timeout)
            if resp.status == 200:
                data = json.loads(resp.read())
                models = [m["name"] for m in data.get("models", [])]
                if model in models or any(model in m for m in models):
                    return True, "model found"
                return False, f"model '{model}' not in {models[:3]}..."
            return False, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)[:60]

    if not api_key:
        return False, "no API key found in .env"

    # Test endpoints per provider
    if provider in ("openai", "openai-codex"):
        base = url or "https://api.openai.com/v1"
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/models")
            req.add_header("Authorization", f"Bearer {api_key}")
            resp = urllib.request.urlopen(req, timeout=timeout)
            return resp.status == 200, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            body = e.read().decode()[:200]
            if e.code == 401: return False, "HTTP 401 — invalid API key"
            if e.code == 429: return False, "HTTP 429 — rate limited or quota exhausted"
            return False, f"HTTP {e.code} — {body[:80]}"
        except Exception as e:
            return False, str(e)[:60]

    if provider == "deepseek":
        base = url or "https://api.deepseek.com/v1"
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/models")
            req.add_header("Authorization", f"Bearer {api_key}")
            resp = urllib.request.urlopen(req, timeout=timeout)
            return resp.status == 200, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            body = e.read().decode()[:200]
            if e.code == 401: return False, "HTTP 401 — invalid API key"
            if e.code == 429: return False, "HTTP 429 — rate limited"
            if e.code == 402: return False, "HTTP 402 — insufficient quota"
            return False, f"HTTP {e.code} — {body[:80]}"
        except Exception as e:
            return False, str(e)[:60]

    if provider == "openrouter":
        base = url or "https://openrouter.ai/api/v1"
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/models")
            req.add_header("Authorization", f"Bearer {api_key}")
            resp = urllib.request.urlopen(req, timeout=timeout)
            return resp.status == 200, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            if e.code == 401: return False, "HTTP 401 — invalid key"
            if e.code == 402: return False, "HTTP 402 — insufficient credits"
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)[:60]

    if provider == "anthropic":
        base = url or "https://api.anthropic.com"
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/v1/messages")
            req.add_header("x-api-key", api_key)
            req.add_header("anthropic-version", "2023-06-01")
            # Don't send a real request body, just check auth
            resp = urllib.request.urlopen(req, timeout=timeout)
            return False, f"HTTP {resp.status} (unexpected)"
        except urllib.error.HTTPError as e:
            if e.code == 401: return False, "HTTP 401 — invalid API key"
            if e.code == 429: return False, "HTTP 429 — rate limited"
            return False, f"HTTP {e.code}"
        except Exception as e:
            return False, str(e)[:60]

    # Google / Gemini: uses key as query param
    if provider in ("google", "gemini"):
        base = url or "https://generativelanguage.googleapis.com/v1beta"
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/models?key={api_key}")
            resp = urllib.request.urlopen(req, timeout=timeout)
            return resp.status == 200, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            body = e.read().decode()[:200]
            if e.code == 401: return False, "HTTP 401 — invalid API key"
            if e.code == 429: return False, "HTTP 429 — rate limited"
            return False, f"HTTP {e.code} — {body[:80]}"
        except Exception as e:
            return False, str(e)[:60]

    # xAI, Groq, NVIDIA, Z.AI, Kimi, MiniMax, Alibaba, LM Studio, Copilot...
    # All speak OpenAI-compatible /v1/models with Bearer token
    openai_compat = {
        "xai": "https://api.x.ai/v1",
        "groq": "https://api.groq.com/openai/v1",
        "nvidia": "https://integrate.api.nvidia.com/v1",
        "zai": "https://api.z.ai/api/paas/v4",
        "kimi-coding": "https://api.moonshot.ai/v1",
        "minimax": "https://api.minimax.io/anthropic",
        "alibaba": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
        "lmstudio": url or "http://127.0.0.1:1234/v1",
        "copilot": "https://models.github.ai/v1",
    }
    if provider in openai_compat:
        base = url or openai_compat[provider]
        try:
            req = urllib.request.Request(f"{base.rstrip('/')}/models")
            req.add_header("Authorization", f"Bearer {api_key}")
            resp = urllib.request.urlopen(req, timeout=timeout)
            return resp.status == 200, f"HTTP {resp.status}"
        except urllib.error.HTTPError as e:
            body = e.read().decode()[:200]
            if e.code == 401: return False, "HTTP 401 — invalid API key"
            if e.code == 429: return False, "HTTP 429 — rate limited / quota"
            if e.code == 403: return False, "HTTP 403 — access denied (check key scope)"
            return False, f"HTTP {e.code} — {body[:80]}"
        except Exception as e:
            return False, str(e)[:60]

    # OAuth providers: check token validity from auth.json
    oauth_providers = ["nous", "openai-codex", "qwen-oauth", "google-gemini-cli",
                       "minimax-oauth", "copilot-acp"]
    if provider in oauth_providers:
        auth_path = _hermes_dir() / "auth.json"
        if not auth_path.exists():
            return False, "no auth.json — run 'hermes login' first"
        try:
            auth = json.loads(auth_path.read_text())
            pdata = auth.get("providers", {}).get(provider)
            if not pdata:
                return False, f"not authenticated — run 'hermes login --provider {provider}'"
            access_token = pdata.get("access_token", "")
            expires_at = pdata.get("expires_at", "")
            if not access_token:
                return False, "no access token in auth.json"
            if expires_at:
                exp = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
                now = datetime.now().astimezone()
                if exp < now:
                    return False, f"token expired at {expires_at[:19]} — run 'hermes login'"
            # Test the token against the provider's endpoint
            base = url or pdata.get("inference_base_url", "")
            if not base:
                return True, "token present (no endpoint to test)"
            try:
                req = urllib.request.Request(f"{base.rstrip('/')}/models")
                req.add_header("Authorization", f"Bearer {access_token}")
                resp = urllib.request.urlopen(req, timeout=timeout)
                return resp.status == 200, f"HTTP {resp.status} — token valid"
            except urllib.error.HTTPError as e:
                if e.code == 401: return False, "HTTP 401 — token expired or revoked"
                if e.code == 403: return False, "HTTP 403 — insufficient scope"
                return False, f"HTTP {e.code}"
            except Exception as e:
                return False, str(e)[:60]
        except Exception as e:
            return False, f"auth.json parse error: {str(e)[:60]}"

    # Generic: test connectivity only (unknown provider or no deep probe available)
    return check_health(entry, timeout), "connectivity only (no deep probe for this provider)"


def cmd_test(args=None):
    """Health-check all substrates. Use --deep for credentialed API probe."""
    deep = args and "--deep" in args if args else False
    cfg = load_config(); chain = cfg.get("chain", [])
    if not chain: print("No substrates to test."); return
    timeout = cfg.get("health_check_timeout", 5)
    print(f"Health check{' (DEEP — API credentials)' if deep else ''}:")
    print("─" * 55)
    for i, entry in enumerate(chain):
        prov, model = entry["provider"], entry["model"]
        if deep:
            healthy, detail = check_health_deep(entry, timeout)
            status = "✓ OK" if healthy else f"✗ FAIL"
            print(f"  [{i}] {prov}/{model}: {status} — {detail}")
        else:
            healthy = check_health(entry, timeout)
            status = "✓ ONLINE" if healthy else "✗ OFFLINE"
            detail = ""
            if not healthy and (entry.get("local") or entry.get("url")):
                detail = " (no API response)"
            print(f"  [{i}] {prov}/{model}: {status}{detail}")

# ── Auto-failover logic ────────────────────────────────────────────────
def record_failure():
    """Record a failure on the active substrate. Switch if threshold reached."""
    cfg = load_config()
    state = load_state()
    chain = cfg.get("chain", [])
    if len(chain) <= 1:
        return None
    if not cfg.get("auto_failover", True):
        return None

    active = state.get("active_index", 0)
    threshold = cfg.get("fail_threshold", 3)
    failures = state.setdefault("failures", {})
    key = str(active)
    failures[key] = failures.get(key, 0) + 1
    state["last_switch"] = datetime.now().isoformat()
    save_state(state)

    if failures[key] >= threshold and active + 1 < len(chain):
        next_idx = active + 1
        state["active_index"] = next_idx
        state["failures"] = {}
        save_state(state)
        entry = chain[next_idx]
        return f"Auto-switched to substrate [{next_idx}]: {entry['provider']}/{entry['model']}"
    return None

def record_success():
    """Record a success — resets failure counter for active substrate."""
    state = load_state()
    state["last_success"] = datetime.now().isoformat()
    key = str(state.get("active_index", 0))
    if key in state.get("failures", {}):
        state["failures"][key] = 0
    save_state(state)

# ── Top providers helper ──────────────────────────────────────────────
def _top_providers() -> list:
    top = ["deepseek", "openrouter", "anthropic", "openai-codex", "openai", "google", "xai", "ollama"]
    others = [k for k in sorted(HERMES_PROVIDERS) if k not in top]
    return top + others[:3]

# ── Commands ──────────────────────────────────────────────────────────
def cmd_add(args):
    if len(args) < 2:
        print("Usage: sustrato add <provider> <model> [--url <endpoint>] [--local]")
        sys.exit(1)
    provider, model = args[0], args[1]
    url, is_local = None, False
    remaining = args[2:]
    i = 0
    while i < len(remaining):
        if remaining[i] == "--url" and i+1 < len(remaining):
            url = remaining[i+1]; i += 2
        elif remaining[i] == "--local":
            is_local = True; i += 1
        else:
            i += 1
    if is_local and not url:
        url = "http://localhost:11434/v1"

    cfg = load_config()
    chain = cfg.setdefault("chain", [])

    # --- FIX: detect duplicates ---
    for idx, existing in enumerate(chain):
        if existing.get("provider") == provider and existing.get("model") == model:
            label = ["PRIMARY","SECONDARY","TERTIARY"][idx] if idx < 3 else f"#{idx}"
            print(f"⚠ Already in chain at [{label}] index {idx}. Use 'sustrato remove {idx}' first.")
            return

    entry = {"provider": provider, "model": model}
    if url: entry["url"] = url
    if is_local: entry["local"] = True
    chain.append(entry)
    save_config(cfg)

    idx = len(chain) - 1
    labels = ["PRIMARY","SECONDARY","TERTIARY"]
    label = labels[idx] if idx < 3 else f"#{idx}"
    url_str = f" @ {url}" if url else ""
    print(f"[{label}] {provider}/{model}{url_str} added (substrate {idx})")

def cmd_remove(args):
    if not args:
        print("Usage: sustrato remove <index>"); sys.exit(1)
    cfg = load_config()
    try: idx = int(args[0])
    except ValueError: print(f"Invalid index: {args[0]}"); sys.exit(1)
    chain = cfg.get("chain", [])
    if idx < 0 or idx >= len(chain):
        print(f"Index {idx} out of range (0-{len(chain)-1})"); sys.exit(1)
    removed = chain.pop(idx)
    save_config(cfg)
    print(f"Removed [{idx}]: {removed['provider']}/{removed['model']}")

def cmd_list():
    cfg = load_config(); state = load_state()
    chain = cfg.get("chain", [])
    if not chain:
        print("No substrates configured.\n\nAdd one: sustrato add <provider> <model>")
        return
    active = state.get("active_index", 0)
    labels = ["PRIMARY","SECONDARY","TERTIARY"]
    print("Substrate chain:"); print("─"*55)
    for i, entry in enumerate(chain):
        label = labels[i] if i < 3 else f"#{i}"
        marker = " ← ACTIVE" if i == active else ""
        url_str = f" @ {entry['url']}" if entry.get("url") else ""
        local_tag = " [LOCAL]" if entry.get("local") else ""
        print(f"  [{label}] {entry['provider']}/{entry['model']}{url_str}{local_tag}{marker}")
    print("─"*55)
    print(f"Auto-failover: {'ON' if cfg.get('auto_failover', True) else 'OFF'}")
    print(f"Fail threshold: {cfg.get('fail_threshold', 3)} failures")
    f_total = sum(state.get("failures", {}).values())
    if f_total:
        print(f"Current failures: {f_total}")
    if state.get("last_switch"):
        print(f"Last switch: {state['last_switch']}")

def cmd_switch(args):
    if not args: print("Usage: sustrato switch <index>"); sys.exit(1)
    cfg = load_config(); state = load_state(); chain = cfg.get("chain", [])
    if not chain: print("No substrates configured."); sys.exit(1)
    try: idx = int(args[0])
    except ValueError: print(f"Invalid index: {args[0]}"); sys.exit(1)
    if idx < 0 or idx >= len(chain):
        print(f"Index {idx} out of range (0-{len(chain)-1})"); sys.exit(1)
    old = state.get("active_index", 0)
    state["active_index"] = idx
    state["failures"] = {}
    state["last_switch"] = datetime.now().isoformat()
    save_state(state)
    entry = chain[idx]
    labels = ["primary","secondary","tertiary"]
    label = labels[idx] if idx < 3 else f"substrate #{idx}"
    print(f"Switched: [{old}] → [{idx}] ({label})")
    print(f"Now using: {entry['provider']}/{entry['model']}")
    print(f"\nRestart Hermes session or /reset to apply.")

def cmd_reset():
    state = {"active_index": 0, "failures": {}, "last_switch": None, "last_success": None}
    save_state(state)
    print("Reset to primary substrate. Failure counters cleared.")

def cmd_auto(args):
    if not args or args[0] not in ("on","off"):
        print("Usage: sustrato auto <on|off>"); sys.exit(1)
    cfg = load_config()
    cfg["auto_failover"] = args[0] == "on"
    save_config(cfg)
    print(f"Auto-failover: {args[0].upper()}")

def cmd_providers(_args=None):
    print("Available providers (from Hermes PROVIDER_REGISTRY):"); print("─"*55)
    for pid, info in sorted(HERMES_PROVIDERS.items()):
        name = info["name"]; auth = info.get("auth_type","?")
        env_str = ", ".join(info.get("env_vars",[]))
        if env_str: env_str = f"  [{env_str}]"
        print(f"  {pid:<22} {name:<28} {auth}{env_str}")
    print("─"*55); print(f"Total: {len(HERMES_PROVIDERS)} providers")
    print(); print("Use any provider ID with: sustrato add <provider> <model>")

def cmd_failures(_args=None):
    """Show current failure state across all substrates."""
    state = load_state(); cfg = load_config()
    chain = cfg.get("chain", [])
    active = state.get("active_index", 0)
    failures = state.get("failures", {})
    threshold = cfg.get("fail_threshold", 3)
    print("Failure tracking:"); print("─"*45)
    for i, entry in enumerate(chain):
        key = str(i); count = failures.get(key, 0)
        bar = "█" * count + "░" * (threshold - count)
        marker = " ← ACTIVE" if i == active else ""
        print(f"  [{i}] {entry['provider']}/{entry['model']}: [{bar}] {count}/{threshold}{marker}")
    if state.get("last_success"):
        print(f"  Last success: {state['last_success']}")

def cmd_setup(_args=None):
    cfg = load_config(); chain = cfg.get("chain", [])
    print(); print("╔══════════════════════════════════════════════╗")
    print("║   🔄  SUSTRATO SETUP — Provider Failover    ║")
    print("╚══════════════════════════════════════════════╝"); print()
    if chain: print(f"Current chain: {len(chain)} substrate(s)"); print()
    # Primary
    print("── Primary substrate (your main provider) ──")
    print("   This is your everyday driver.")
    provider = _prompt("   Provider", default=chain[0]["provider"] if chain else "deepseek", examples=_top_providers())
    model = _prompt("   Model", default=chain[0]["model"] if chain else "deepseek-v4-pro", examples=["deepseek-v4-pro","claude-sonnet-4","gpt-4o"])
    print()
    # Secondary
    print("── Secondary substrate (cloud fallback) ──")
    print("   Kicks in when primary fails.")
    add_secondary = _confirm("   Add secondary fallback?")
    sec_provider = sec_model = None
    if add_secondary:
        sec_provider = _prompt("   Provider", default=chain[1]["provider"] if len(chain)>1 else "openrouter", examples=["openrouter","deepseek","anthropic"])
        sec_model = _prompt("   Model", default=chain[1]["model"] if len(chain)>1 else "anthropic/claude-sonnet-4", examples=["anthropic/claude-sonnet-4","deepseek-v4-pro"])
    print()
    # Tertiary
    print("── Tertiary substrate (local Ollama) ──")
    print("   Runs offline. Slower but always available.")
    add_tertiary = _confirm("   Add local Ollama fallback?")
    ollama_url = "http://localhost:11434/v1"
    ter_model = None
    if add_tertiary:
        default_model = chain[2]["model"] if len(chain)>2 else "llama3:8b"
        ter_model = _prompt("   Ollama model", default=default_model, examples=["llama3:8b","llama3:70b","mistral:7b"])
        ollama_url = _prompt("   URL", default="http://localhost:11434/v1")
    print()
    # Auto-failover
    print("── Auto-failover ──")
    auto = _confirm("   Enable automatic failover?", default=cfg.get("auto_failover", True))
    threshold = 3
    if auto:
        threshold_str = _prompt("   Failure threshold", default="3", examples=["2","3","5"])
        try: threshold = int(threshold_str)
        except ValueError: threshold = 3
    print()
    # Build
    new_chain = [{"provider":provider, "model":model}]
    if add_secondary and sec_provider:
        new_chain.append({"provider":sec_provider, "model":sec_model})
    if add_tertiary and ter_model:
        entry = {"provider":"ollama", "model":ter_model, "local":True}
        if ollama_url != "http://localhost:11434/v1": entry["url"] = ollama_url
        new_chain.append(entry)
    cfg["chain"] = new_chain
    cfg["auto_failover"] = auto
    cfg["fail_threshold"] = threshold
    save_config(cfg)
    save_state({"active_index":0,"failures":{},"last_switch":None,"last_success":None})
    print("── Summary ──"); print()
    labels = ["PRIMARY","SECONDARY","TERTIARY"]
    for i, entry in enumerate(new_chain):
        url_str = f" @ {entry.get('url','')}" if entry.get('url') else ""
        local_tag = " [LOCAL]" if entry.get('local') else ""
        print(f"  [{labels[i]}] {entry['provider']}/{entry['model']}{url_str}{local_tag}")
    print(); print(f"  Auto-failover: {'ON' if auto else 'OFF'} (threshold: {threshold})"); print()
    print("✓ Configuration saved"); print("  Restart Hermes or /reset to activate.")

def _prompt(label, default="", examples=None):
    d = f" [{default}]" if default else ""
    print(f"{label}{d}: ", end="", flush=True)
    if examples: print(f"(e.g. {', '.join(examples)})"); print(f"{label}: ", end="", flush=True)
    try:
        v = input().strip(); return v if v else default
    except (EOFError, KeyboardInterrupt): print(); return default

def _confirm(prompt, default=True):
    yn = "Y/n" if default else "y/N"
    try:
        v = input(f"{prompt} [{yn}]: ").strip().lower()
        return default if not v else v in ("y","yes")
    except (EOFError, KeyboardInterrupt): print(); return default

