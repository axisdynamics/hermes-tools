# ── Main ──────────────────────────────────────────────────────────────
def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help","--help","-h"):
        cmd_help(); return
    cmd = sys.argv[1]; args = sys.argv[2:]
    commands = {
        "add": cmd_add, "remove": cmd_remove,
        "list": lambda _: cmd_list(), "test": cmd_test,
        "switch": cmd_switch, "reset": lambda _: cmd_reset(),
        "auto": cmd_auto, "providers": lambda _: cmd_providers(),
        "failures": lambda _: cmd_failures(), "setup": lambda _: cmd_setup(),
        "help": lambda _: cmd_help(),
    }
    if cmd in commands: commands[cmd](args)
    else: print(f"Unknown command: {cmd}"); cmd_help(); sys.exit(1)

if __name__ == "__main__":
    main()
