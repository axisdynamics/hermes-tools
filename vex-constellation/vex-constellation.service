# VEX Constellation HTTP node (user service)

[Unit]
Description=VEX Constellation HTTP node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERMES_HOME=%h/.hermes
Environment=PYTHONUNBUFFERED=1
# Optional: override LAN identity and seed peers, e.g.
# Environment=VEX_PUBLIC_URL=http://192.168.1.17:8390
# Environment=VEX_BOOTSTRAP_PEERS=http://192.168.1.5:8390,http://192.168.1.20:8390
Environment=VEX_KEEPALIVE_SECONDS=60
WorkingDirectory=%h/.hermes/plugins/vex-constellation
ExecStart=/usr/bin/python3 %h/.hermes/plugins/vex-constellation/run_constellation.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
