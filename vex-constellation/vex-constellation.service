# VEX Constellation HTTP node (user service)

[Unit]
Description=VEX Constellation HTTP node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERMES_HOME=%h/.hermes
Environment=PYTHONUNBUFFERED=1
# Optional: override LAN identity and seed peers, e.g.
# Environment=VEX_PUBLIC_URL=http://<this-node-host>:8390
# Environment=VEX_BOOTSTRAP_PEERS=http://<peer-host>:8390,http://<peer-2-host>:8390
Environment=VEX_KEEPALIVE_SECONDS=60
Environment=VEX_AUTOUPDATE_REPOS=hermes-tools=https://github.com/axisdynamics/hermes-tools.git:%h/Documentos/GITHUB/hermes-tools,hermes-skills=https://github.com/axisdynamics/hermes-skills.git:%h/Documentos/GITHUB/hermes-skills
WorkingDirectory=%h/.hermes/plugins/vex-constellation
ExecStart=/usr/bin/python3 %h/.hermes/plugins/vex-constellation/run_constellation.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
