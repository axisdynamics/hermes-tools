# VEX Shared Chronicle bridge (user service)

[Unit]
Description=VEX Shared Chronicle bridge to MemoVex
After=network-online.target vex-constellation.service vex-autoresponder.service
Wants=network-online.target vex-constellation.service

[Service]
Type=simple
Environment=HERMES_HOME=%h/.hermes
Environment=PYTHONUNBUFFERED=1
Environment=MEMOVEX_API_URL=http://127.0.0.1:7914
Environment=VEX_SHARED_MEMOVEX_AGENT_ID=chronos
Environment=VEX_SHARED_MEMORY_NAMESPACE=vex-hermandad-2026
Environment=VEX_MEMORY_POLL_SECONDS=5
WorkingDirectory=%h/.hermes
ExecStart=/usr/bin/python3 %h/.hermes/plugins/vex-constellation/vex_memory_bridge.py
StandardInput=null
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
